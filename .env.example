# Get your OpenAI API Key here: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=****

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Public site URL (canonical domain for SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://bot.sutio.co

# NextAuth base URL (production)
AUTH_URL=https://bot.sutio.co

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****

# Secret for Vercel Cron jobs (generate like AUTH_SECRET). Vercel sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=****
